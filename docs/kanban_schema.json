{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KanbanBoard",
    "description": "JSON Schema describing the Kanban board structure stored per-user in the database.",
    "type": "object",
    "required": [
        "id",
        "title",
        "columns",
        "cards"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "UUID for the board"
        },
        "title": {
            "type": "string"
        },
        "meta": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "updated_at": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "additionalProperties": true
        },
        "columns": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "cardIds"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "cardIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "cards": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "details": {
                        "type": "string"
                    },
                    "labels": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "assignees": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    },
    "additionalProperties": false
}